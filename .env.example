# PostgreSQL connection string
# Example: postgresql://esnaa_user:your_password@localhost:5432/esnaa
DATABASE_URL=

# Port the Express server listens on
PORT=5000

# Origin(s) allowed to call this API (your frontend URL).
# Local dev example: http://127.0.0.1:5500
# Production example: https://esnaa.example.com
CLIENT_URL=

# Node environment: development | production
NODE_ENV=development
